  {
    "table": {
      "name": "organization_join_requests",
      "schema": "public"
    },
    "select_permissions": [
      {
        "role": "user",
        "permission": {
          "columns": ["id", "org_id", "user_id", "status", "requested_at", "reviewed_by", "reviewed_at"],
          "filter": {
            "_or": [
              {
                "user_id": {
                  "_eq": "X-Hasura-User-Id"
                }
              },
              {
                "organization": {
                  "org_members": {
                    "_and": [
                      { "user_id": { "_eq": "X-Hasura-User-Id" } },
                      { "role": { "_eq": "owner" } }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    ],
    "insert_permissions": [
      {
        "role": "user",
        "permission": {
          "check": {
            "_and": [
              { "user_id": { "_eq": "X-Hasura-User-Id" } },
              { "status": { "_eq": "pending" } }
            ]
          },
          "columns": ["org_id", "user_id", "status"]
        }
      }
    ]
  },
