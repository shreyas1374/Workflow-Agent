# Nhost Configuration
# Find these in your Nhost Dashboard: Project Settings -> App Info

# Option 1: Subdomain and Region (Cloud)
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-nhost-subdomain
NEXT_PUBLIC_NHOST_REGION=us-east-1

# Option 2: Custom Backend URL (Optional fallback for custom/local deployment)
# NEXT_PUBLIC_NHOST_BACKEND_URL=https://your-nhost-subdomain.nhost.run
