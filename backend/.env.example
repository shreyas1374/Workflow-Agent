# =====================================================================
# AI Agent Workflow Backend — Environment Variables
# =====================================================================
# The backend automatically loads environment variables from:
#   1. Project root `.env.local`  (Recommended — shared with Next.js)
#   2. `backend/.env.local`
#   3. Project root `.env`
#   4. `backend/.env`
# =====================================================================

# PostgreSQL Database Connection String (Nhost Cloud / Local Postgres)
DATABASE_URL=postgres://postgres:52qMhmEqMGaZj3ha@lvxtjinpxcgopdtpnlop.db.ap-south-1.nhost.run:5432/lvxtjinpxcgopdtpnlop

# LLM API Keys
GROQ_API_KEY=gsk_...
NVIDIA_API_KEY=nvapi-...
GEMINI_API_KEY=...
OPENROUTER_API_KEY=...

# Default LLM Provider: groq | nvidia | gemini (default: groq)
LLM_PROVIDER=groq

# Stub Modes — set to true ONLY during automated CI / test suites
LLM_STUB_MODE=false
HTTP_STUB_MODE=false
